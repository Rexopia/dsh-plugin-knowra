{
  "name": "dsh-plugin-knowra",
  "version": "0.2.3",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit",
    "prepack": "npm run build",
    "test:compat": "node scripts/test-compat.mjs"
  },
  "description": "Knowra for DeepSeek Harness: search arXiv papers by topic, author or exact dates, and read Scout reports on methods, evidence and limitations.",
  "license": "MIT",
  "author": "Knowra <support@knowra.app>",
  "homepage": "https://knowra.app/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rexopia/dsh-plugin-knowra.git"
  },
  "bugs": {
    "url": "https://github.com/Rexopia/dsh-plugin-knowra/issues",
    "email": "support@knowra.app"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "cordis.patch.yml",
    "lib/",
    "icon.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "arxiv",
    "papers",
    "research",
    "literature-search"
  ],
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.0-rc.2 <0.3.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-http-proxy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.3",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox": "0.2.1-rc.3",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-loader": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.3",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.25.12",
    "playwright": "1.58.2",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "tsx": "^4.20.0",
    "typescript": "^6.0.3"
  }
}
